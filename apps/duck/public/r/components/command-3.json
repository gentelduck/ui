      "content": "'use client'\n\nimport {\n  Command,\n  CommandEmpty,\n  CommandGroup,\n  CommandInput,\n  CommandItem,\n  CommandList,\n  CommandSeparator,\n  CommandShortcut,\n} from '@gentleduck/registry-ui/command'\nimport { DirectionProvider } from '@gentleduck/registry-ui/direction'\nimport { Calculator, Calendar, CreditCard, Settings, Smile, User } from 'lucide-react'\n\nexport default function Demo() {\n  return (\n    <DirectionProvider dir=\"rtl\">\n      <Command className=\"h-fit w-80 border pt-0\">\n        <CommandInput placeholder=\"اكتب أمرًا أو ابحث...\" />\n        <CommandList>\n          <CommandEmpty>لا توجد نتائج.</CommandEmpty>\n          <CommandGroup heading=\"اقتراحات\">\n            <CommandItem>\n              <Calendar />\n              <span>التقويم</span>\n            </CommandItem>\n            <CommandItem>\n              <Smile />\n              <span>البحث عن رموز تعبيرية</span>\n            </CommandItem>\n            <CommandItem disabled>\n              <Calculator />\n              <span>الآلة الحاسبة</span>\n            </CommandItem>\n          </CommandGroup>\n          <CommandSeparator />\n          <CommandGroup heading=\"الإعدادات\">\n            <CommandItem>\n              <User />\n              <span>الملف الشخصي</span>\n              <CommandShortcut>⌘P</CommandShortcut>\n            </CommandItem>\n            <CommandItem>\n              <CreditCard />\n              <span>الفوترة</span>\n              <CommandShortcut>⌘B</CommandShortcut>\n            </CommandItem>\n            <CommandItem>\n              <Settings />\n              <span>الإعدادات</span>\n              <CommandShortcut>⌘S</CommandShortcut>\n            </CommandItem>\n          </CommandGroup>\n        </CommandList>\n      </Command>\n    </DirectionProvider>\n  )\n}\n",
      "path": "command/command-3.tsx",
      "target": "components/command-3.tsx",
      "type": "registry:example"
    }
  ],
